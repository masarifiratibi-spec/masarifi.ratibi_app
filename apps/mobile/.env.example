# Public configuration keys for the Masarifi mobile app.
# Copy to `.env` and adjust values. Never commit a real `.env`.
#
# All keys here are safe to expose in the client bundle. Secrets belong in
# Expo SecureStore or a server, never in this file.

# Foundation validation harness toggle. When true, the temporary validation
# menu is shown instead of production screens (which do not exist yet).
EXPO_PUBLIC_FOUNDATION_HARNESS=true

# Selected Expo development client URL (set automatically by `expo start`).
# EXPO_PUBLIC_APP_ORIGIN=
